{
  "schema": "steering.xy_control_candidates/v1",
  "hypothesis": "xy_control",
  "map_version": "v1",
  "map_config": "xy_control_2b_v1.yaml",
  "map_sha256": "ce6d26580625dd97f8aaaffaba77cecd6ac3ab6b32e8f31f7cadacec737e32e9",
  "source": {
    "model_id": "Qwen/Qwen3.5-2B-Base",
    "d_model": 2048,
    "n_hidden_states": 25,
    "hidden_state_index": "0 = embeddings, 1..24 = block output",
    "mapping": {
      "X": "man",
      "Y": "woman"
    },
    "fit_sample": "data/xy_pairs_stagea_v1.json",
    "eval_sample": "data/xy_pairs_stagea_v1.json",
    "label": "paired_xy_control",
    "label_note": "d_i = last-token HS(gendered prompt) − last-token HS(XY prompt) for the same row. v_raw is the mean of d_i on train families. Not a gender direction — a gender-conditioned activation direction.",
    "split": {
      "train_frac": 0.7,
      "val_frac": 0.15,
      "test_frac": 0.15,
      "seed": 0,
      "note": "v_raw is fit only on train families of the fit sample. Stage A default eval is held-out families of the eval sample (val+test of this split if eval==fit; otherwise the whole eval sample)."
    }
  },
  "hook": {
    "site": "residual_stream_hidden_state",
    "positions": "last_prompt_token",
    "note": "Capture and intervention are the same site: last token after \"Answer:\". Do not touch embeddings, logits, KV cache, or attention weights."
  },
  "vectors": [
    {
      "id": "v_raw",
      "short": "vraw",
      "role": "candidate",
      "kind": "paired_mean_diff",
      "description": "Unit mean of paired differences d_i = h_gender − h_XY on train families."
    },
    {
      "id": "v_random",
      "short": "vrand",
      "role": "control",
      "kind": "random_unit",
      "seeds": [
        0,
        1,
        2
      ],
      "description": "Null-контроль — случайное unit-направление (3 seed)."
    }
  ],
  "interventions": [
    {
      "id": "add",
      "formula": "h' = h − α·v̂",
      "reference_c": "none",
      "reference_note": "Additive shift along the unit gender-conditioned direction. α>0 is the hypothesized debiasing direction (h − αv). α<0 tests the opposite sign. α=0 is baseline.",
      "alphas": [
        -2.0,
        -1.0,
        -0.5,
        -0.25,
        0.25,
        0.5,
        1.0,
        2.0
      ]
    }
  ],
  "layers": {
    "belt": [
      14,
      15,
      16,
      17,
      18,
      19,
      20
    ],
    "core": [
      15,
      16,
      17,
      18
    ],
    "edge": [
      14,
      19,
      20
    ],
    "anchor": 16,
    "note": "Тот же пояс, что H1/contrastive на 2B (скачок gender_choice на L15–16)."
  },
  "baseline": {
    "id": "baseline",
    "description": "Без интервенции на той же выборке (α=0)."
  },
  "screening": {
    "stage": "A",
    "sample": {
      "source_split": "val",
      "n_base_items": 95,
      "fraction_of_all_groups": 0.1,
      "stratify_by": "soc_major_title",
      "rows_per_item": 4,
      "seed": 20260809
    },
    "forwards_per_candidate": 380,
    "primary_metric": {
      "id": "gender_gap",
      "formula": "mean_i Δ_i, Δ_i = mean_layouts (log P(man) − log P(woman))",
      "direction": "reduce_abs"
    },
    "secondary_metrics": [
      {
        "id": "mean_abs_delta",
        "formula": "mean_i |Δ_i| after layout average"
      },
      {
        "id": "p_delta_positive",
        "formula": "P(Δ_i > 0)"
      },
      {
        "id": "slot_gap",
        "formula": "mean_i mean_layouts (z_A − z_B)  # guardrail"
      }
    ],
    "guardrails": {
      "mode": "flag",
      "slot_choice_rate_shift_pp_max": 10
    },
    "keep_top": 10,
    "keep_rule": "Среди role=candidate: наибольшее |gender_gap| reduction при неотрицательном (или меньшем) slot-gap сдвиге. random ≈ baseline. Оба знака α должны развести GenderGap в разные стороны, если направление каузально."
  },
  "n_candidates": 47,
