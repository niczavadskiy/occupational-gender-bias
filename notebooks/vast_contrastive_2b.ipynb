  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Contrastive steering — Qwen3.5-2B-Base (Vast / Jupyter)\n",
        "\n",
        "Запуск **без SSH**: откройте ноутбук на Vast Jupyter, вставьте `HF_TOKEN`, гоняйте ячейки сверху вниз.\n",
        "\n",
        "Репо: [niczavadskiy/occupational-gender-bias](https://github.com/niczavadskiy/occupational-gender-bias)  \n",
        "Каталог: `steering/contrastive/`  \n",
        "Инструкция: [`steering/contrastive/CONTRASTIVE_VAST.md`](../steering/contrastive/CONTRASTIVE_VAST.md)\n",
        "\n",
        "Пайплайн: live HS → \(v=\\mu_M-\\mu_F\) → center \(h'=h-\\alpha(s-c)\\hat v\) → Stage A (46 кандидатов + baseline)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# === config ===\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "os.environ[\"HF_TOKEN\"] = os.environ.get(\"HF_TOKEN\", \"hf_PASTE_HERE\")\n",
        "assert not os.environ[\"HF_TOKEN\"].endswith(\"PASTE_HERE\"), \"вставьте реальный HF_TOKEN\"\n",
        "os.environ[\"HUGGING_FACE_HUB_TOKEN\"] = os.environ[\"HF_TOKEN\"]\n",
        "\n",
        "from huggingface_hub import login\n",
        "login(token=os.environ[\"HF_TOKEN\"], add_to_git_credential=False)\n",
        "\n",
        "MODEL = \"Qwen/Qwen3.5-2B-Base\"\n",
        "SCALE = \"2b\"\n",
        "TAG = \"contrastive_2b_a_v1\"\n",
        "SMOKE = False  # True = 3 семьи, 2 кандидата\n",
        "\n",
        "REPO = Path(\"/workspace/occupational-gender-bias\")\n",
        "if not (REPO / \"steering\" / \"contrastive\" / \"run_stagea.py\").is_file():\n",
        "    REPO = Path.cwd()\n",
        "\n",
        "os.chdir(REPO)\n",
        "import sys\n",
        "if str(REPO) not in sys.path:\n",
        "    sys.path.insert(0, str(REPO))\n",
        "os.environ[\"PYTHONPATH\"] = str(REPO) + (\":\" + os.environ[\"PYTHONPATH\"] if os.environ.get(\"PYTHONPATH\") else \"\")\n",
        "\n",
        "print(\"REPO\", REPO.resolve())\n",
        "print(\"sample\", (REPO / \"steering/samples/h1_stagea_sample_v1.json\").is_file())"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# deps (на образе bias-subspaces-env обычно уже есть)\n",
        "%pip install -q \"numpy>=1.26,<2\" \"transformers>=4.50\" accelerate huggingface_hub python-dotenv pyyaml\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "import transformers\n",
        "print(\"numpy\", np.__version__, \"torch\", torch.__version__, \"cuda\", torch.cuda.is_available())\n",
        "print(\"transformers\", transformers.__version__)\n",
        "assert int(np.__version__.split(\".\")[0]) < 2, \"нужен numpy<2\"\n",
        "if torch.cuda.is_available():\n",
        "    print(\"gpu\", torch.cuda.get_device_name(0))"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# 1. каталог кандидатов (CPU)\n",
        "from steering.contrastive.build_candidates import main as build_candidates\n",
        "\n",
        "assert build_candidates([\"--scale\", SCALE]) == 0\n",
        "print(\"candidates ok\")"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# 2. live HS → mean-diff v̂, c  (GPU, ~380 forward на полном sample)\n",
        "from steering.contrastive.build_vectors import main as build_vectors\n",
        "\n",
        "vec_args = [\"--scale\", SCALE, \"--model\", MODEL, \"--device\", \"cuda\", \"--dtype\", \"float32\"]\n",
        "if SMOKE:\n",
        "    vec_args += [\"--n-items\", \"3\"]\n",
        "assert build_vectors(vec_args) == 0"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# 3. Stage A  (полный прогон: 47 конфигов × 380 строк)\n",
        "from steering.contrastive.run_stagea import main as run_stagea\n",
        "\n",
        "stage_args = [\n",
        "    \"--scale\", SCALE,\n",
        "    \"--model\", MODEL,\n",
        "    \"--device\", \"cuda\",\n",
        "    \"--dtype\", \"float32\",\n",
        "    \"--tag\", TAG + (\"_smoke\" if SMOKE else \"\"),\n",
        "]\n",
        "if SMOKE:\n",
        "    stage_args += [\n",
        "        \"--limit-items\", \"3\",\n",
        "        \"--candidates\",\n",
        "        \"main_center_core__vmd__L16__center__a1,anti_steering__vmd__L16__center__am1\",\n",
        "    ]\n",
        "assert run_stagea(stage_args) == 0"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "outputs": [],
      "execution_count": null,
      "source": [
        "# 4. pack\n",
        "import tarfile\n",
        "\n",
        "tag = TAG + (\"_smoke\" if SMOKE else \"\")\n",
        "src = REPO / \"results\" / \"steering\" / \"contrastive\" / \"stage_a\" / tag\n",
        "out = Path(\"/workspace\") / f\"contrastive_stage_a_{tag}.tar.gz\"\n",
        "assert src.is_dir(), src\n",
        "with tarfile.open(out, \"w:gz\") as tar:\n",
        "    tar.add(src, arcname=tag)\n",
        "print(\"packed\", out, \"bytes\", out.stat().st_size)\n",
        "print(\"скачай из Vast Files:\", out)"
      ]
    }
  ]
}
