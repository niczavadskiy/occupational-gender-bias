# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your tokens. `.env` is gitignored.
#   $ cp .env.example .env
#   $ $EDITOR .env
#
# Скрипты inference.py / upload_to_hf.py подхватят значения автоматически
# (через python-dotenv) если запущены из корня репо.
# ---------------------------------------------------------------------------

# HuggingFace access token (write scope нужен для upload_to_hf.py).
# Получить: https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE_ME

# HF Hub cache на отдельный диск (полезно на Vast где overlay disk маленький).
# Дефолт ~/.cache/huggingface; на Vast лучше /workspace/.hf_home.
# HF_HOME=/workspace/.hf_home

# Куда писать results/ (необязательно — по дефолту /workspace/results на Vast,
# либо текущая папка локально).
# RESULTS_DIR=/workspace/results
