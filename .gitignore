# === ML artifacts (HS, model weights, large arrays) ===
# Use HuggingFace Datasets / cloud storage for sharing
*.npz
*.npy
*.pt
*.pth
*.bin
*.safetensors

# === HF / model caches ===
.hf_home/
.cache/

# === Experiment outputs ===
# results/ — НЕ игнорим целиком, чтобы per_item.jsonl + meta.json трекать в git
# (они маленькие, ~1.4 MB, удобно diff'ить между runs).
# Большие артефакты (hidden_states.npz и др.) уже отрезаны выше через *.npz.
inference_*.log
*.log

# === Probe outputs (results/<run>/probes/) ===
# В git: json, md, csv. NPZ (*.npz) и inspect_h11/_shared — локально.
results/*/probes/**
!results/*/probes/**/
!results/*/probes/**/*.json
!results/*/probes/**/*.md
!results/*/probes/**/*.csv
results/*/probes/inspect_h11/
results/*/probes/_shared/

# === Behavioral metrics (results/<run>/metrics/<timestamp>/) ===
# В git: csv / json / jsonl / md в подпапках metrics. Остальное — локально.
results/*/metrics/**
!results/*/metrics/**/
!results/*/metrics/**/*.csv
!results/*/metrics/**/*.json
!results/*/metrics/**/*.jsonl
!results/*/metrics/**/*.md

# Технический скрипт (не user-facing)
probes/download_hf.py


# === Generated derived data ===
# Исходные CSV от Никиты (data/factorial_*.csv) — коммитим (~500 KB каждый).
# Prepared JSONL — генерится из CSV через prepare_factorial.py, не коммитим.
data/*.prepared.jsonl

# LLM annotation runs — track json / jsonl / csv; ignore editor locks
data/annotation/runs/**
!data/annotation/runs/**/
!data/annotation/runs/**/*.json
!data/annotation/runs/**/*.jsonl
!data/annotation/runs/**/*.csv
!data/annotation/runs/.gitkeep
data/annotation/runs/**/.~lock*

# === Secrets ===
.env
.env.local

# EDA HF download cache
.hf_cache/
